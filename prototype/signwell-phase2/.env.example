# Mock remains the default. Do not store production or customer data here.
PROVIDER_MODE=mock

# Provider mode is local-only and requires the explicit Test Mode gate.
# PROVIDER_MODE=signwell-test
SIGNWELL_TEST_MODE=true
SIGNWELL_API_KEY=replace-with-a-SignWell-test-account-api-key
SIGNWELL_TEMPLATE_ID=replace-with-reviewed-synthetic-template-id

# Copy the expected roles and field API IDs from fixtures/signwell-template-mapping.example.json.
# Replace every placeholder value with IDs reviewed in the SignWell test account.
SIGNWELL_TEMPLATE_MAPPING={"customer":{"id":"1","placeholderId":"replace_customer_placeholder_id","name":"Customer"},"hyc":{"id":"2","placeholderId":"replace_hyc_placeholder_id","name":"HYC Representative"},"fields":{"owner_name":{"apiId":"replace_owner_name","label":"Owner"},"contracting_business":{"apiId":"replace_contracting_business","label":"Contracting business"},"signer_name":{"apiId":"replace_signer_name","label":"Person signing"},"owner_email":{"apiId":"replace_owner_email","label":"Owner email"},"vessel_name":{"apiId":"replace_vessel_name","label":"Vessel name"},"vessel_model":{"apiId":"replace_vessel_model","label":"Vessel model"},"vessel_length":{"apiId":"replace_vessel_length","label":"Vessel length"},"vessel_value":{"apiId":"replace_vessel_value","label":"Approximate vessel value"},"hin_or_registration":{"apiId":"replace_hin_or_registration","label":"HIN or registration"},"plan":{"apiId":"replace_plan","label":"Plan"},"visit_frequency":{"apiId":"replace_visit_frequency","label":"Visit frequency"},"billing_cadence":{"apiId":"replace_billing_cadence","label":"Billing cadence"},"price":{"apiId":"replace_price","label":"Simulated price"},"included_activity":{"apiId":"replace_included_activity","label":"Included activity"},"emergency_spending_authority":{"apiId":"replace_emergency_spending_authority","label":"Emergency spending authority"},"agreement_version":{"apiId":"replace_agreement_version","label":"Agreement version"},"agreement_notice":{"apiId":"replace_agreement_notice","label":"Agreement status notice"}}}
