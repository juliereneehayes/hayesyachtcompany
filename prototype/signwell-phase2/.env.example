# Mock remains the default. Do not store production or customer data here.
PROVIDER_MODE=mock

# Provider mode is local-only and requires the explicit Test Mode gate.
# PROVIDER_MODE=signwell-test
SIGNWELL_TEST_MODE=true
SIGNWELL_API_KEY=replace-with-a-SignWell-test-account-api-key
SIGNWELL_TEMPLATE_ID=replace-with-reviewed-synthetic-template-id

# The mapping below matches the verified HYC synthetic template. For another template, copy IDs from its read-only Get Template report.
SIGNWELL_TEMPLATE_MAPPING={"customer":{"id":"1","placeholderId":"1","name":"Customer"},"hyc":{"id":"2","placeholderId":"2","name":"Hyc Representative"},"fields":{"owner_name":{"apiId":"owner","label":"Owner"},"contracting_business":{"apiId":"contracting_business","label":"Contracting business"},"signer_name":{"apiId":"person_signing","label":"Person signing"},"owner_email":{"apiId":"owner_email","label":"Owner email"},"vessel_name":{"apiId":"vessel_name","label":"Vessel name"},"vessel_model":{"apiId":"vessel_model","label":"Vessel model"},"vessel_length":{"apiId":"vessel_length","label":"Vessel length"},"vessel_value":{"apiId":"approximate_vessel_value","label":"Approximate vessel value"},"hin_or_registration":{"apiId":"hin_or_registration","label":"HIN or registration"},"plan":{"apiId":"plan","label":"Plan"},"visit_frequency":{"apiId":"visit_frequency","label":"Visit frequency"},"billing_cadence":{"apiId":"billing_cadence","label":"Billing cadence"},"price":{"apiId":"simulated_price","label":"Simulated price"}}}
